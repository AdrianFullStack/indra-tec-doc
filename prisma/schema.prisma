generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(50)
  lastname  String    @db.VarChar(50)
  email     String    @unique @db.VarChar(50)
  password  String    @db.VarChar(100)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  files     File[]
  folders   Folder[]

  @@map("users")
}

model Folder {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(50)
  position  Int       @db.SmallInt
  ownerId   String    @map("owner_id") @db.Uuid
  folderId  String?   @map("folder_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  files     File[]
  parent    Folder?   @relation("FolderHierarchy", fields: [folderId], references: [id])
  children  Folder[]  @relation("FolderHierarchy")
  owner     User      @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([folderId])
  @@map("folders")
}

model File {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  originalName String    @db.VarChar(100)
  mimeType     String    @db.VarChar(20)
  extension    String    @db.VarChar(20)
  size         Float
  key          String    @db.VarChar(200)
  bucket       String    @db.VarChar(200)
  folderId     String    @map("folder_id") @db.Uuid
  ownerId      String    @map("owner_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  folder       Folder    @relation(fields: [folderId], references: [id])
  owner        User      @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([folderId])
  @@map("files")
}
